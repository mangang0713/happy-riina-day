{
  "name": "h1key-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "worker:dev": "wrangler dev --config workers/community-api/wrangler.jsonc",
    "worker:typecheck": "tsc --noEmit -p workers/community-api/tsconfig.json",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"supabase/**/*.ts\" \"workers/**/*.{ts,jsonc}\" \"scripts/**/*.mjs\" \"eslint.config.js\" \"vite.config.ts\" \"tsconfig*.json\" \"package.json\" \".prettierrc\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"supabase/**/*.ts\" \"workers/**/*.{ts,jsonc}\" \"scripts/**/*.mjs\" \"eslint.config.js\" \"vite.config.ts\" \"tsconfig*.json\" \"package.json\" \".prettierrc\"",
    "data:import": "node scripts/import-schedules.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.14",
    "maplibre-gl": "^6.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.2.5",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "^4.152.0"
  }
}
